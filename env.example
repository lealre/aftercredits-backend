# Postgres credentials. REQUIRED — there is no longer a fallback to the literal
# "aftercredits" (that meant a missing value silently connected with a
# published credential). Set a real password; the app refuses to start without
# POSTGRES_PASSWORD.
POSTGRES_USER=aftercredits
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Host port the compose postgres service publishes (only needed if 5432 is taken)
POSTGRES_PORT_HOST=5432
POSTGRES_DB=aftercredits

SUPERUSER_USERNAME=
SUPERUSER_EMAIL=
SUPERUSER_PASSWORD=

# JWT signing secret (REQUIRED - the server refuses to start if unset)
JWT_SECRET=

# Title metadata provider: hybrid | tmdb | omdb | imdbapi
# See internal/titleprovider/README.md for a comparison.
#   hybrid  -> TMDB metadata + OMDb IMDb ratings (recommended; needs TMDB_API_KEY + OMDB_API_KEY)
#   tmdb    -> TMDB only (TMDB's own ratings)   | omdb -> OMDb only (IMDb ratings, thin episodes)
TITLE_PROVIDER=hybrid
# TMDB v3 API key (required for hybrid and tmdb)
TMDB_API_KEY=
# OMDb API key (required for hybrid and omdb) - free: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=
# Pagination (optional; defaults shown)
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
DEFAULT_SEARCH_LIMIT=5

# Activity feed (group activity events + unread badge + live SSE stream).
# Off unless set: no events are recorded, the /activity routes are absent, and
# no LISTEN connection is opened for the stream.
#
# With it on, the stream needs `proxy_buffering off` and a proxy_read_timeout
# above 60s on /activity/stream, or it connects and then delivers nothing.
ACTIVITY_FEED_ENABLED=false

# Activity feed retention. OFF by default: the feed is an append-only log and
# every event is kept until you decide otherwise.
#
# When enabled, the weekly routines job deletes events older than
# ACTIVITY_RETENTION_DAYS. Deleting history is the one thing that job does that
# cannot be undone and has no backup of its own, so it takes a deliberate opt-in
# rather than happening because nobody changed a default. Accepts true/1/yes/on;
# anything else — including a typo — leaves it off.
ACTIVITY_RETENTION_ENABLED=false
# Only consulted when the above is on. Values below 1 are ignored.
ACTIVITY_RETENTION_DAYS=90

# Metrics listener (Prometheus scrape target).
#
# A SEPARATE listener from the API's :8080 — it is not a route on the API, and
# nothing proxies it. Prometheus reaches it container-to-container, and a deploy
# never publishes it, so nginx never sees it. (This repo's local compose
# publishes it on 127.0.0.1 only, so curl works without putting it on the LAN.)
#
# There is no authentication on it: it is safe because it is not published,
# which is also why publishing it would expose it.
#
# Defaults to on: the listener is network-internal either way, so enabling it
# changes nothing about what is reachable. Accepts true/false/1/0.
METRICS_ENABLED=true
METRICS_ADDR=:9090

# Observability stack (docker-compose.observability.yaml).
#
# Name of the already-running application stack's Docker network. The default
# matches this repo's local compose; on the Pi set aftercredits_default, which
# is the network the frontend repo's stack creates.
STACK_NETWORK=aftercredits-backend_default
# Grafana admin password. REQUIRED — the observability stack refuses to start
# without it, deliberately, so a missing value cannot leave admin/admin on a
# reachable port.
GRAFANA_ADMIN_PASSWORD=

# Host-side ports, overridable for the same reason POSTGRES_PORT_HOST is above:
# the CONTAINER side never changes, but which port the host publishes is the
# host's business. Set one only when its default is already taken — on the
# machine this stack was built on, all three of them were.
#   API_PORT_HOST       app API     (default 8080)
#   METRICS_PORT_HOST   raw metrics (default 9090, loopback only)
#   GRAFANA_PORT_HOST   dashboards  (default 3000)
API_PORT_HOST=8080
METRICS_PORT_HOST=9090
GRAFANA_PORT_HOST=3000

# Which interface Grafana's port is published on.
#
# Defaults to all of them, because on the Pi the dashboards have to be reachable
# from another device — that is the whole point there. Set it to 127.0.0.1 for a
# development machine: Grafana is the one service in this stack with a login
# page, and a password chosen for convenience does not belong on a network you
# do not control.
GRAFANA_BIND_IP=0.0.0.0
