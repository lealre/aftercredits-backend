POSTGRES_USER=aftercredits
POSTGRES_PASSWORD=aftercredits
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Host port the compose postgres service publishes (only needed if 5432 is taken)
POSTGRES_PORT_HOST=5432
POSTGRES_DB=aftercredits

SUPERUSER_USERNAME=
SUPERUSER_EMAIL=
SUPERUSER_PASSWORD=

# JWT signing secret (REQUIRED - the server refuses to start if unset)
JWT_SECRET=

# Title metadata provider: hybrid | tmdb | omdb | imdbapi
# See internal/titleprovider/README.md for a comparison.
#   hybrid  -> TMDB metadata + OMDb IMDb ratings (recommended; needs TMDB_API_KEY + OMDB_API_KEY)
#   tmdb    -> TMDB only (TMDB's own ratings)   | omdb -> OMDb only (IMDb ratings, thin episodes)
TITLE_PROVIDER=hybrid
# TMDB v3 API key (required for hybrid and tmdb)
TMDB_API_KEY=
# OMDb API key (required for hybrid and omdb) - free: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=
# Pagination (optional; defaults shown)
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
DEFAULT_SEARCH_LIMIT=5

# Activity feed (group activity events + unread badge + live SSE stream).
# Off unless set: no events are recorded, the /activity routes are absent, and
# no LISTEN connection is opened for the stream.
#
# With it on, the stream needs `proxy_buffering off` and a proxy_read_timeout
# above 60s on /activity/stream, or it connects and then delivers nothing.
ACTIVITY_FEED_ENABLED=false
