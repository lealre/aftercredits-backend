{
  "uid": "aftercredits-backend",
  "title": "Aftercredits Backend",
  "description": "The backend's health at a glance: the top row answers 'is anything wrong right now' in numbers. Charts below give the trend once you need it.",
  "tags": ["aftercredits"],
  "schemaVersion": 39,
  "version": 3,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Right now",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Status",
      "description": "Whether Prometheus can scrape the API. UP means the metrics endpoint answered; DOWN means the scrape failed, and every other number on this page is stale.",
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red", "index": 0 },
                "1": { "text": "UP", "color": "green", "index": 1 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto"
      },
      "targets": [
        { "refId": "A", "expr": "up{job=\"aftercredits-backend\"}", "legendFormat": "API", "instant": false }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Memory",
      "description": "Resident memory the API process actually holds. This is what it costs the machine — broader than the Go heap, and the number that matters on a small host.",
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "color": { "mode": "none" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "auto"
      },
      "targets": [
        { "refId": "A", "expr": "process_resident_memory_bytes", "legendFormat": "RSS" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "CPU",
      "description": "CPU used, as a percentage of a single core. On a multi-core host this can exceed 100% — 400% means all four cores busy.",
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": { "mode": "none" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "auto"
      },
      "targets": [
        { "refId": "A", "expr": "rate(process_cpu_seconds_total[5m]) * 100", "legendFormat": "of one core" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Requests in flight",
      "description": "Requests being served at this instant. A number that keeps climbing and never returns near zero means requests are piling up faster than they finish.",
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "none" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "auto"
      },
      "targets": [
        { "refId": "A", "expr": "aftercredits_http_requests_in_flight", "legendFormat": "in flight" }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "DB connections",
      "description": "Database connections currently checked out of the pool. Compare against the pool ceiling in the Database section below — a number pinned at the ceiling is the usual cause of slow requests.",
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "none" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "auto"
      },
      "targets": [
        { "refId": "A", "expr": "aftercredits_db_pool_connections{state=\"acquired\"}", "legendFormat": "in use" }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Goroutines",
      "description": "Live goroutines. Should be roughly flat. A line that climbs and stays climbed is the classic signature of a leak — this is the one number worth watching over days, not minutes.",
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "none" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "auto"
      },
      "targets": [
        { "refId": "A", "expr": "go_goroutines", "legendFormat": "goroutines" }
      ]
    },

    {
      "id": 101,
      "type": "row",
      "title": "Requests",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Request rate by route",
      "description": "Requests per second, split by the route pattern that matched. Unmatched traffic is requests that reached no registered route.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "expr": "sum by (route) (rate(aftercredits_http_requests_total[5m]))", "legendFormat": "{{route}}" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Latency percentiles",
      "description": "Half of requests are faster than p50; 95% are faster than p95. Watch p95 and p99 — the average hides slow outliers.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(aftercredits_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(aftercredits_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(aftercredits_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p99" }
      ]
    },

    {
      "id": 102,
      "type": "row",
      "title": "Responses",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Response status",
      "description": "Responses per second by status code. 401s are ordinary here — the API returns them whenever a token is missing or expired.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "expr": "sum by (status) (rate(aftercredits_http_requests_total[5m]))", "legendFormat": "{{status}}" }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Requests in flight, over time",
      "description": "The in-flight gauge as a trend. A sawtooth means steady work; a rising floor means requests are outliving their arrival rate.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        { "refId": "A", "expr": "aftercredits_http_requests_in_flight", "legendFormat": "in flight" }
      ]
    },

    {
      "id": 103,
      "type": "row",
      "title": "Runtime",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Heap in use vs allocated",
      "description": "Go's heap: what is in use right now, against what it has taken from the OS. A wide and growing gap is memory the garbage collector has not returned yet.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "expr": "go_memstats_heap_inuse_bytes", "legendFormat": "in use" },
        { "refId": "B", "expr": "go_memstats_heap_alloc_bytes", "legendFormat": "allocated" }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "GC pause",
      "description": "Average stop-the-world pause per collection. Spikes here line up with latency spikes in the Requests section — that is how you tell GC pressure from a slow query.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        { "refId": "A", "expr": "rate(go_gc_duration_seconds_sum[5m]) / rate(go_gc_duration_seconds_count[5m])", "legendFormat": "mean pause" }
      ]
    },

    {
      "id": 104,
      "type": "row",
      "title": "Database",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 33 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Pool connections by state",
      "description": "Connections by state. The one to watch is 'acquired' approaching 'max': once they meet, every further query waits in line rather than running.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 34 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "expr": "aftercredits_db_pool_connections", "legendFormat": "{{state}}" }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Pool waits and cancellations",
      "description": "Acquires that had to wait for a free connection, and acquires abandoned because the request gave up first. Both should sit at zero — anything above it means the pool ceiling is too low for the traffic.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 34 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ops", "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "expr": "rate(aftercredits_db_pool_empty_acquires_total[5m])", "legendFormat": "had to wait" },
        { "refId": "B", "expr": "rate(aftercredits_db_pool_canceled_acquires_total[5m])", "legendFormat": "gave up waiting" }
      ]
    }
  ]
}
