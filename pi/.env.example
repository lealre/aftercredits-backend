# Environment variables for the movies-update scheduled task (backups are done by pi-watcher)
# Copy this file to .env and configure your values

# ============================================
# Cron Schedule Configuration
# ============================================

# Movies update schedule (cron expression)
# Default: Monday at midnight (0 0 * * 1) - midnight after Sunday
# Format: minute hour day month day-of-week
# Examples:
#   0 0 * * 1     - Every Monday at midnight (midnight after Sunday)
#   0 0 * * 5     - Every Friday at midnight
#   */2 * * * *   - Every 2 minutes (for testing)
MOVIES_UPDATE_SCHEDULE=0 0 * * 1

# ============================================
# Docker Network Configuration
# ============================================

# Docker network the job joins to reach Postgres: pi-infra's shared network.
# Default: infra
DOCKER_NETWORK=infra

# ============================================
# Postgres Configuration
# ============================================

# Set DEPLOY_ENV_FILE to the absolute path of the compose stack's .env and the
# scheduled tasks will read POSTGRES_*, TITLE_PROVIDER and the API keys from it,
# passed as an additional --env-file. Keeping one copy means rotating the
# password cannot silently break the job. Leave it unset to define those
# variables here instead.
# DEPLOY_ENV_FILE=/absolute/path/to/deploy/.env

# ============================================
# Notes
# ============================================
# 
# Cron Schedule Format:
# * * * * *
# │ │ │ │ │
# │ │ │ │ └─── Day of week (0-7, Sunday = 0 or 7)
# │ │ │ └───── Month (1-12)
# │ │ └─────── Day of month (1-31)
# │ └───────── Hour (0-23)
# └─────────── Minute (0-59)
#
# For testing, you can use:
#   MOVIES_UPDATE_SCHEDULE=*/2 * * * * # Every 2 minutes
